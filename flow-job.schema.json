{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grovetools/flow/pkg/orchestration/job",
  "$defs": {
    "AutonomousConfig": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idle_minutes": {
          "type": "integer"
        },
        "prompt": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "enabled",
        "idle_minutes"
      ]
    },
    "InlineConfig": {
      "properties": {
        "Categories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "Categories"
      ]
    },
    "SkillFidelityState": {
      "properties": {
        "skill": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "artifacts_expected": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "artifacts_produced": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": "string"
        },
        "diagnostic_path": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "skill",
        "status",
        "artifacts_expected",
        "artifacts_produced"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the job"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the job"
    },
    "status": {
      "type": "string",
      "description": "Current execution status (pending/running/completed/failed)"
    },
    "type": {
      "type": "string",
      "description": "Job type determining execution behavior (oneshot/chat/interactive_agent/headless_agent/shell/file)"
    },
    "model": {
      "type": "string",
      "description": "LLM model to use for this job"
    },
    "template": {
      "type": "string",
      "description": "Template name for generating the job prompt"
    },
    "skill": {
      "type": "string",
      "description": "Skill name to inject into the agent context (resolved via skills package)"
    },
    "skill_sequence": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "List of skills to execute in sequence"
    },
    "playbook": {
      "type": "string",
      "description": "Per-job playbook override (normally inherited from .grove-plan.yml)"
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "List of job IDs that must complete before this job runs"
    },
    "include": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Files or globs to include as context in the job prompt"
    },
    "source_block": {
      "type": "string",
      "description": "Reference to a named block in another job to use as input"
    },
    "source_file": {
      "type": "string",
      "description": "Path to source file for context"
    },
    "memory": {
      "type": "boolean",
      "description": "Whether to inject related memories into the prompt (default: true)"
    },
    "repository": {
      "type": "string",
      "description": "Git repository URL for worktree creation"
    },
    "branch": {
      "type": "string",
      "description": "Git branch name for worktree"
    },
    "worktree": {
      "type": "string",
      "description": "Worktree name for isolated execution"
    },
    "inline": {
      "$ref": "#/$defs/InlineConfig",
      "description": "Controls which content types are inlined vs uploaded"
    },
    "prepend_dependencies": {
      "type": "boolean",
      "description": "DEPRECATED: Use inline: [dependencies] instead"
    },
    "on_complete_status": {
      "type": "string",
      "description": "Status to set on dependent jobs when this job completes"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job was last modified"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job completed execution"
    },
    "duration": {
      "type": "integer",
      "description": "Total execution time"
    },
    "source_plan": {
      "type": "string",
      "description": "Reference to the plan this job was generated from"
    },
    "recipe_name": {
      "type": "string",
      "description": "Name of the recipe used to create this job"
    },
    "generate_plan_from": {
      "type": "boolean",
      "description": "Generate a new plan from this job's output"
    },
    "git_changes": {
      "type": "boolean",
      "description": "Include git diff/status in job context"
    },
    "gather_concept_notes": {
      "type": "boolean",
      "description": "Include related concept notes in context"
    },
    "gather_concept_plans": {
      "type": "boolean",
      "description": "Include related concept plans in context"
    },
    "rules_file": {
      "type": "string",
      "description": "Path to rules file for agent behavior"
    },
    "used_rules_file": {
      "type": "string",
      "description": "Archived rules file used during last execution"
    },
    "note_ref": {
      "type": "string",
      "description": "Reference to a notebook entry for context"
    },
    "channels": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "External channels to enable (e.g. signal)"
    },
    "autonomous": {
      "$ref": "#/$defs/AutonomousConfig",
      "description": "Autonomous idle pinger configuration"
    },
    "skill_fidelity": {
      "items": {
        "$ref": "#/$defs/SkillFidelityState"
      },
      "type": "array",
      "description": "Skill sequence execution fidelity records"
    }
  },
  "type": "object",
  "title": "Grove Flow Job",
  "description": "Schema for Grove Flow job frontmatter in markdown files."
}