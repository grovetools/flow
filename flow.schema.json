{
  "$defs": {
    "ProviderConfig": {
      "properties": {
        "args": {
          "description": "Command-line arguments for this provider",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-important": true,
          "x-layer": "global",
          "x-priority": "65"
        },
        "input_mode": {
          "description": "Input mode for interactive sessions: vim or standard",
          "type": "string"
        }
      },
      "required": [
        "args"
      ],
      "type": "object"
    },
    "RecipeConfig": {
      "properties": {
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variable overrides for this recipe",
          "type": "object",
          "x-layer": "project",
          "x-priority": "90"
        }
      },
      "required": [
        "vars"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/grovetools/flow/pkg/orchestration/flow-config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for the 'flow' extension in grove.yml.",
  "properties": {
    "agent_env": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variables injected into all agent subprocesses",
      "type": "object",
      "x-layer": "global",
      "x-priority": "64"
    },
    "agent_target": {
      "description": "Agent launch target: auto/native/tmux",
      "type": "string"
    },
    "handoff_max": {
      "description": "Default upper bound on chained coordinator handoffs (0 = built-in default 3)",
      "type": "integer",
      "x-layer": "global",
      "x-priority": "54"
    },
    "handoff_threshold": {
      "description": "Default context-window usage percent that arms an autonomous coordinator handoff (0 = built-in default 80)",
      "type": "integer",
      "x-layer": "global",
      "x-priority": "53"
    },
    "interactive_provider": {
      "description": "Provider for interactive sessions: claude/codex/opencode",
      "enum": [
        "claude",
        "codex",
        "opencode"
      ],
      "type": "string",
      "x-important": true,
      "x-layer": "global",
      "x-priority": "55"
    },
    "max_consecutive_steps": {
      "description": "Maximum consecutive steps before requiring user input",
      "type": "integer",
      "x-layer": "global",
      "x-priority": "85"
    },
    "oneshot_model": {
      "description": "Default model for oneshot jobs",
      "type": "string",
      "x-important": true,
      "x-layer": "global",
      "x-priority": "60"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "description": "Configuration for agent providers",
      "type": "object",
      "x-important": true,
      "x-layer": "global",
      "x-priority": "65"
    },
    "recipes": {
      "additionalProperties": {
        "$ref": "#/$defs/RecipeConfig"
      },
      "description": "Recipe-specific variable overrides",
      "type": "object",
      "x-layer": "project",
      "x-priority": "90"
    },
    "run_init_by_default": {
      "description": "Run init actions by default (nil = true)",
      "type": "boolean",
      "x-layer": "project",
      "x-priority": "81"
    }
  },
  "title": "Grove Flow Configuration",
  "type": "object"
}